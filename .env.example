# Copy to .env and adjust. Every value has a sane default, so .env is OPTIONAL.
# ---------------------------------------------------------------------------

# Web UI port on the host
HTTP_PORT=8080

# ---- Database (kept inside the Docker network) ----
POSTGRES_USER=meeting
POSTGRES_PASSWORD=change-me-please
POSTGRES_DB=meeting

# ---- Speech-to-text (faster-whisper) ----
# large-v3-turbo = best speed/quality for Persian on small hardware.
# Options: large-v3 (best Persian, slower) | small (fastest, weaker) | medium
WHISPER_MODEL=large-v3-turbo
# Meeting language. fa = Persian/Farsi. Leave blank to auto-detect.
WHISPER_LANGUAGE=fa
# auto | cpu | cuda
WHISPER_DEVICE=auto
# auto | int8 (CPU) | int8_float16 (small GPU) | float16 (GPU)
WHISPER_COMPUTE_TYPE=auto

# ---- Summarization LLM (Ollama) ----
# gemma4:e2b-it-qat (~4.3GB) fits CPU / a 2-6GB GPU. Newest QAT, multilingual.
# Better Persian: gemma4:e4b-it-qat (~6.1GB) | gemma4:12b-it-qat (best)
# Alt: qwen2.5:7b-instruct | partai/dorna-llama3 (Persian)
OLLAMA_MODEL=gemma4:e2b-it-qat
# Language of the generated minutes. auto = same language as the meeting.
SUMMARY_LANGUAGE=auto

# ---- Speaker diarization ("who said what") — optional, heavier ----
# Requires building the diarization image and a HuggingFace token (see docs).
DIARIZATION_ENABLED=false
HUGGINGFACE_TOKEN=

# ---- Privacy ----
# Auto-delete source audio after N days (0 = keep). Transcripts are always kept.
AUDIO_RETENTION_DAYS=0

# ---- Jitsi: in-meeting "Record & Summarize" button (profile: jitsi) ----
# Set this to your Jitsi server and the platform will host meetings at
# /meet/<room> with a built-in record button. Start the bot with:
#   docker compose --profile jitsi up -d
JITSI_SERVER_URL=https://meet.yourcompany.com
# Name the recording bot shows in the meeting.
BOT_DISPLAY_NAME=Meeting Summarizer
# Optional JWT if your Jitsi requires authentication.
JITSI_JWT=
